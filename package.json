{
  "name": "nftables-napi",
  "version": "0.6.0",
  "description": "Native Node.js binding for nftables via libnftnl+libmnl — nftables firewall management",
  "keywords": [
    "blacklist",
    "firewall",
    "ip-ban",
    "iptables",
    "libmnl",
    "libnftnl",
    "napi",
    "native",
    "netfilter",
    "netlink",
    "nft",
    "nftables",
    "node-addon"
  ],
  "homepage": "https://github.com/kastov/nftables-napi#readme",
  "bugs": {
    "url": "https://github.com/kastov/nftables-napi/issues"
  },
  "license": "AGPL-3.0-only",
  "author": {
    "name": "kastov",
    "url": "https://github.com/kastov"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kastov/nftables-napi.git"
  },
  "files": [
    "lib/",
    "src/",
    "prebuilds/*/*.node"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:deps": "node scripts/build-deps.mjs",
    "clean": "rm -rf prebuilds .deps",
    "test": "node --test test/test.mjs"
  },
  "devDependencies": {
    "@types/node": ">= 24 < 25",
    "node-addon-api": "^8.9.2",
    "node-api-headers": "^1.9.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
