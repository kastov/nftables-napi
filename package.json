{
  "name": "nftables-napi",
  "version": "0.6.0",
  "description": "Native Node.js binding for nftables via libnftnl+libmnl — nftables firewall management",
  "author": {
    "name": "kastov",
    "url": "https://github.com/kastov"
  },
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/kastov/nftables-napi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kastov/nftables-napi.git"
  },
  "bugs": {
    "url": "https://github.com/kastov/nftables-napi/issues"
  },
  "keywords": [
    "nftables",
    "nft",
    "firewall",
    "netfilter",
    "libnftnl",
    "libmnl",
    "netlink",
    "iptables",
    "ip-ban",
    "blacklist",
    "native",
    "napi",
    "node-addon"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/",
    "src/",
    "prebuilds/",
    "binding.gyp"
  ],
  "gypfile": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "install": "node-gyp-build || true",
    "build": "node-gyp rebuild",
    "rebuild": "node-gyp rebuild",
    "test": "node --test test/test.mjs",
    "prebuild:all": "./prebuild-all.sh"
  },
  "dependencies": {
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp": "^12.2.0",
    "prebuildify": "^6.0.1",
    "@types/node": ">= 24 < 25"
  }
}
